rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'abcsingh925@gmail.com' ||
        request.auth.token.email == 'hariom@iiitbhopal.ac.in' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc (used to verify Firestore connectivity on boot)
    match /test/connection {
      allow read: if true;
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Items collection (Lost & Found reports)
    match /items/{itemId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Item claims collection
    match /item_claims/{claimId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
